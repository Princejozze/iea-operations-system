# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# development or production. Production turns on the HTTPS proxy header, secure cookies,
# the HTTPS redirect and HSTS, and requires DEBUG=False, CSRF_TRUSTED_ORIGINS and LOG_FILE.
# Left empty, DEBUG=True means development; DEBUG=False with no ENVIRONMENT is refused.
ENVIRONMENT=development

# Production only (required there). The site's https:// origin(s), comma-separated.
CSRF_TRUSTED_ORIGINS=
# Production only. HSTS max-age in seconds: 3600 to start, 31536000 after the first stable week.
# SECURE_HSTS_SECONDS=3600

# Logging. Everything goes to stderr; with LOG_FILE set, to that file too (required in
# production, e.g. /var/log/iea/app.log). Secrets and passwords are scrubbed from every line.
LOG_FILE=
LOG_LEVEL=INFO

# Local dev (matches docker-compose.yml). For production, point this at
# the RDS endpoint instead: postgres://user:pass@<rds-endpoint>:5432/iea
DATABASE_URL=postgres://iea:iea@localhost:5432/iea

# Flip on once the S3 bucket + a scoped IAM user (not root) exist.
USE_S3=False

# Where uploads go when USE_S3=False. REQUIRED in that case, and must be OUTSIDE the
# repository: tender documents carry bid pricing and a stray `git add` must not find them.
# Startup refuses a path inside the repo. Example (Windows): C:\Users\you\iea-media
MEDIA_ROOT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=af-south-1

# Google Workspace SMTP (use an app password, not the account password)
# or swap EMAIL_BACKEND for a transactional provider later.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@imperialeastafrica.tz

# Free tier: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# Gemini extraction. Pick a current Flash-tier model from Google's docs; do not
# hardcode a model name in source.
GEMINI_API_KEY=
GEMINI_MODEL=
